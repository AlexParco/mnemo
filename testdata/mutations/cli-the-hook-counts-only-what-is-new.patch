Breaks: The hook says how many messages it has not announced yet rather than how many are waiting, so a chat is told "1 message(s) waiting" and mailbox_read hands over three.
Must fail: go test ./internal/cli -run '^TestTheHookTellsABusyChatItHasPost$' -count=1

diff --git a/internal/cli/hook.go b/internal/cli/hook.go
index 5af390d..2d8f4fb 100644
--- a/internal/cli/hook.go
+++ b/internal/cli/hook.go
@@ -195,7 +195,7 @@ func waitingPost(resolved config.Settings, state *sessionState, spanish bool) st
 	// Everything unread, not only what has not been announced: the number has to
 	// be the number mailbox_read will hand over. Saying "1 message(s) waiting"
 	// and then delivering three is worse than saying nothing.
-	top, waiting, err := mailboxFor(resolved).Peek(address, 0)
+	top, waiting, err := mailboxFor(resolved).Peek(address, state.AnnouncedPost)
 	if err != nil || len(waiting) == 0 {
 		return ""
 	}
