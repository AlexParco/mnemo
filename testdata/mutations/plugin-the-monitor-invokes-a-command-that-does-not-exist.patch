+++ b/plugin/monitors/monitors.json
@@ -1,7 +1,7 @@
 [
   {
     "name": "mailbox",
-    "command": "mnemo watch --tool claude",
+    "command": "mnemo mailbox watch --tool claude",
     "description": "mnemo mailbox: messages sent to this chat"
   }
 ]
