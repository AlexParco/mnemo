Breaks: saving shares the nested tables with the map of unknown keys, so after one save mnemo reports its own settings as keys it does not recognise.
Must fail: go test ./internal/config -run '^TestSavingDoesNotConfuseItsOwnKeysForUnknownOnes$'

diff --git a/internal/config/file.go b/internal/config/file.go
index 7736819..497b4e2 100644
--- a/internal/config/file.go
+++ b/internal/config/file.go
@@ -181,7 +181,10 @@ func (f *File) Save() error {
 	// writing a known key into the copy would then write it into extra too. The
 	// file on disk would still be right, and the next `mnemo config` would report
 	// mnemo's own settings as keys it does not recognise.
-	out := clone(f.extra)
+	out := map[string]any{}
+	for key, value := range f.extra {
+		out[key] = value
+	}
 	put(out, "machine", f.Machine != "", f.Machine)
 	put(out, "lang", f.Lang != "", f.Lang)
 	put(out, "store.dir", f.Store.Dir != "", f.Store.Dir)
