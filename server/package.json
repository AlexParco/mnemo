{
  "name": "@alexparco/mnemo-mcp",
  "version": "0.1.0",
  "description": "MCP server for mnemo: per-project persistent memory in plain text + git.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mnemo-mcp": "dist/src/bin.js"
  },
  "files": [
    "dist/src",
    "assets"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "build": "npm run assets && tsc",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "node dist/src/bin.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
